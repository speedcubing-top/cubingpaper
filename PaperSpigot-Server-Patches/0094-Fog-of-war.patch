+package top.speedcubing.cubingpaper.fow;
+
+import it.unimi.dsi.fastutil.ints.Int2IntOpenHashMap;
+import it.unimi.dsi.fastutil.ints.IntOpenHashSet;
+import net.minecraft.server.Entity;
+import top.speedcubing.cubingpaper.CubingPaperConfig;
+
+/** Per viewer fog of war state. Main thread only. */
+public final class FogOfWarView {
+
+    // ids of players this viewer is not sent
+    private final IntOpenHashSet hidden = new IntOpenHashSet();
+    // consecutive checks a not yet hidden player was out of sight: hiding waits a few checks so a player
+    // dancing on a wall edge is not destroyed and respawned every check
+    private final Int2IntOpenHashMap unseenChecks = new Int2IntOpenHashMap();
+
+    // this player's own movement per tick, from its position at the last two samples
+    double velX, velY, velZ;
+    private double lastX, lastY, lastZ;
+    private int lastTick = -1;
+
+    public boolean isHidden(int entityId) {
+        return hidden.contains(entityId);
+    }
+
+    void sampleVelocity(Entity entity, int tick) {
+        if (lastTick >= 0 && tick > lastTick) {
+            int ticks = tick - lastTick; // more than the interval when checks were skipped
+            velX = (entity.locX - lastX) / ticks;
+            velY = (entity.locY - lastY) / ticks;
+            velZ = (entity.locZ - lastZ) / ticks;
+        }
+        lastX = entity.locX;
+        lastY = entity.locY;
+        lastZ = entity.locZ;
+        lastTick = tick;
+    }
+
+    /** @return whether the hidden state of this player changed */
+    boolean update(int entityId, boolean visible) {
+        if (visible) {
+            unseenChecks.remove(entityId);
+            return hidden.remove(entityId);
+        }
+        if (hidden.contains(entityId)) return false;
+        int unseen = unseenChecks.addTo(entityId, 1) + 1;
+        if (unseen < CubingPaperConfig.fogOfWarHideAfterChecks) return false;
+        unseenChecks.remove(entityId);
+        return hidden.add(entityId);
+    }
+
+    /** The player left the world: drop its state. */
+    public void forget(int entityId) {
+        hidden.remove(entityId);
+        unseenChecks.remove(entityId);
+    }
+
+    /** Clears every hidden player, returning their ids. */
+    int[] revealAll() {
+        int[] ids = hidden.toIntArray();
+        hidden.clear();
+        unseenChecks.clear();
+        return ids;
+    }
+
+    boolean hasHidden() {
+        return !hidden.isEmpty();
+    }
+}
