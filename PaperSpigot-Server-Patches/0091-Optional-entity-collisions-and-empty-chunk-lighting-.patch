Subject: [PATCH] Optional entity collisions and empty-chunk lighting fast path


diff --git a/src/main/java/net/minecraft/server/Chunk.java b/src/main/java/net/minecraft/server/Chunk.java
index 88a33147..0207fcb5 100644
--- a/src/main/java/net/minecraft/server/Chunk.java
+++ b/src/main/java/net/minecraft/server/Chunk.java
@@ -216,6 +216,14 @@ public class Chunk {
 
     public void initLighting() {
         int i = this.g();
+        // CubingPaper start - no sections at all: the loops below only reach these assignments (~8k block lookups)
+        if (i == 0 && this.sections[0] == null) {
+            java.util.Arrays.fill(this.f, -999);
+            this.t = Integer.MAX_VALUE;
+            this.q = true;
+            return;
+        }
+        // CubingPaper end
 
         this.t = Integer.MAX_VALUE;
 
diff --git a/src/main/java/net/minecraft/server/EntityLiving.java b/src/main/java/net/minecraft/server/EntityLiving.java
index 3a988d38..f5b0f576 100644
--- a/src/main/java/net/minecraft/server/EntityLiving.java
+++ b/src/main/java/net/minecraft/server/EntityLiving.java
@@ -1759,6 +1759,7 @@ public abstract class EntityLiving extends Entity {
     protected void doTick() {}
 
     protected void bL() {
+        if (top.speedcubing.cubingpaper.CubingPaperConfig.disableEntityCollisions) return; // CubingPaper - no entity pushing
         List list = this.world.a((Entity) this, this.getBoundingBox().grow(0.20000000298023224D, 0.0D, 0.20000000298023224D), Predicates.and(IEntitySelector.d, new Predicate() {
             public boolean a(Entity entity) {
                 return entity.ae();
diff --git a/src/main/java/net/minecraft/server/World.java b/src/main/java/net/minecraft/server/World.java
index 46f15dea..e4d0cdde 100644
--- a/src/main/java/net/minecraft/server/World.java
+++ b/src/main/java/net/minecraft/server/World.java
@@ -1244,6 +1244,7 @@ public abstract class World implements IBlockAccess {
         if (entity instanceof EntityArmorStand) return arraylist; // TacoSpigot - Optimize armor stand movement
         if (entity instanceof EntityTNTPrimed) return arraylist; // TacoSpigot - Optimize tnt entity movement
         if (entity instanceof EntityFallingBlock) return arraylist; // TacoSpigot - Optimize falling block movement
+        if (top.speedcubing.cubingpaper.CubingPaperConfig.disableEntityCollisions) return arraylist; // CubingPaper - skip the per-move entity scan
 
         double d0 = 0.25D;
         List list = this.getEntities(entity, axisalignedbb.grow(d0, d0, d0));
diff --git a/src/main/java/top/speedcubing/cubingpaper/CubingPaperConfig.java b/src/main/java/top/speedcubing/cubingpaper/CubingPaperConfig.java
index 38c087e9..0b92f8d3 100644
--- a/src/main/java/top/speedcubing/cubingpaper/CubingPaperConfig.java
+++ b/src/main/java/top/speedcubing/cubingpaper/CubingPaperConfig.java
@@ -138,6 +138,12 @@ public class CubingPaperConfig {
         lagCompensatedPotions = getBoolean("lagCompensatedPotions", false);
     }
 
+    // CubingPaper - entities never block or push each other: skips the nearby-entity scan on every move and tick
+    public static boolean disableEntityCollisions;
+    private static void disableEntityCollisions() {
+        disableEntityCollisions = getBoolean("disableEntityCollisions", false);
+    }
+
     // CubingPaper start - Packet limiter (from Paper, via PandaSpigot)
     public static final class PacketLimit {
         public final long intervalNS;
