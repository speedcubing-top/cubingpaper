+        player.sendMessage(SEPARATOR + "\n\u00a7a\u00a7lProjectiles values: \n");
+        sendValues(player, profile, profile.getProjectilesValues());
+        TextComponent back = clickable("\n\u00a78\u00a7l[\u00a7c\u00a7l\u2b11\u00a78\u00a7l] ", "\u00a7e[Click to back]",
+                "/kb", ClickEvent.Action.RUN_COMMAND);
+        TextComponent knockback = clickable("\u00a78\u00a7l[\u00a7a\u00a7lEdit knockback\u00a78\u00a7l]",
+                "\u00a7e[Click here to edit this knockback]", "/kb view " + profile.getName(), ClickEvent.Action.RUN_COMMAND);
+        player.spigot().sendMessage(new BaseComponent[] { back, knockback });
+        player.sendMessage(SEPARATOR);
+    }
+
+    private void sendValues(Player player, KnockbackProfile profile, String[] values) {
+        for (String value : values) {
+            TextComponent text = new TextComponent("\u00a76\u00bb \u00a7e" + value);
+            TextComponent edit = clickable(" \u00a78\u00a7l[\u00a7e\u00a7l\u270e\u00a78\u00a7l]",
+                    "\u00a7e[Click to edit " + value + " value]",
+                    "/kb edit " + profile.getName() + " " + value.replace("\u00a77: ", " "), ClickEvent.Action.SUGGEST_COMMAND);
+            player.spigot().sendMessage(new BaseComponent[] { text, edit });
+        }
+    }
+
+    private static TextComponent clickable(String message, String hover, String command, ClickEvent.Action action) {
+        TextComponent component = new TextComponent(message);
+        component.setHoverEvent(new HoverEvent(HoverEvent.Action.SHOW_TEXT, new ComponentBuilder(hover).create()));
+        component.setClickEvent(new ClickEvent(action, command));
+        return component;
+    }
+
+    private static boolean isValidName(String name) {
+        for (int i = 0; i < name.length(); i++) {
+            char c = name.charAt(i);
+            if (!Character.isLetterOrDigit(c) && c != '-' && c != '_') {
+                return false;
+            }
+        }
+        return !name.isEmpty();
+    }
+}
