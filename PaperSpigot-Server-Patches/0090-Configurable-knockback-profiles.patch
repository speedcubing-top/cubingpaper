+            // Not reproducible: the 50/50 position/yaw direction blend and the beyond-3-blocks extra reduction.
+            CraftKnockbackProfile mmc = new CraftKnockbackProfile("mmc");
+            mmc.setFrictionHorizontal(1_000_000D);
+            mmc.setFrictionVertical(1_000_000D);
+            mmc.setHorizontal(0.5301D);
+            mmc.setVertical(0.3622D);
