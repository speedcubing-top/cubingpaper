+        CraftKnockbackProfile windpvp = windSpigotProfile("windpvp");
+        windpvp.setHorizontal(0.35D);
+        windpvp.setRodHorizontal(0.425D);
+        windpvp.setArrowHorizontal(0.425D);
+        windpvp.setPearlHorizontal(0.35D);
+        windpvp.setSnowballHorizontal(0.425D);
+        windpvp.setEggHorizontal(0.425D);
+        windpvp.setExtraHorizontal(0.425D);
