+        }
+    }
+
+    private static CraftKnockbackProfile windSpigotProfile(String name) {
+        CraftKnockbackProfile profile = new CraftKnockbackProfile(name);
+        profile.setVerticalMin(-1.0D); // WindSpigot's lower clamp
+        return profile;
+    }
+
+    public static void registerCommands() {
