+/**
+ * WindSpigot's knockback profile editor.
+ */
+public class KnockbackCommand extends Command {
+
+    private static final String SEPARATOR = "\u00a78\u00a7m-=-------------------------=-";
+    private static final List<String> SUBCOMMANDS = ImmutableList.of("create", "delete", "load", "view", "projectile", "set", "edit");
+    private static final List<String> KNOCKBACK_VALUES = ImmutableList.of("horizontal", "vertical", "vertical-max",
+            "vertical-min", "extra-horizontal", "extra-vertical", "friction-horizontal", "friction-vertical",
+            "stop-sprint", "wtap-extra-horizontal", "wtap-extra-vertical", "add-horizontal", "add-vertical");
+    private static final List<String> PROJECTILE_VALUES = ImmutableList.of("rod-horizontal", "rod-vertical",
+            "arrow-horizontal", "arrow-vertical", "pearl-horizontal", "pearl-vertical", "snowball-horizontal",
+            "snowball-vertical", "egg-horizontal", "egg-vertical");
+
+    public KnockbackCommand(String name) {
+        super(name);
+        this.description = "Assists in knockback configuration.";
+        this.usageMessage = "/knockback [create|delete|load|view|projectile <profile>] [set <profile> <player>] [edit <profile> <value> <amount>]";
+        this.setAliases(ImmutableList.of("kb"));
+        this.setPermission("bukkit.command.knockback");
+    }
+
+    @Override
+    public boolean execute(CommandSender sender, String commandLabel, String[] args) {
+        if (!testPermission(sender)) {
+            return true;
+        }
+        if (!(sender instanceof Player)) {
+            sender.sendMessage("\u00a7cOnly players can use this command.");
+            return true;
+        }
+        Player player = (Player) sender;
+
+        if (args.length == 2) {
+            String name = args[1];
+            switch (args[0].toLowerCase()) {
+                case "create": {
+                    if (!isValidName(name)) {
+                        player.sendMessage("\u00a7cProfile names may only contain letters, digits, '-' and '_'.");
+                    } else if (KnockbackConfig.getKbProfileByName(name) != null) {
+                        player.sendMessage("\u00a7cA knockback profile with that name already exists.");
+                    } else {
+                        KnockbackConfig.createProfile(name);
+                        knockbackCommandMain(player);
+                        player.sendMessage("\u00a7aThe profile \u00a7e" + name + " \u00a7ahas been created.");
+                    }
+                    return true;
+                }
+                case "delete": {
+                    if (KnockbackConfig.getCurrentKb().getName().equalsIgnoreCase(name)) {
+                        knockbackCommandMain(player);
+                        player.sendMessage("\u00a7cYou cannot delete the profile that is being used.");
+                    } else if (KnockbackConfig.deleteProfile(name)) {
+                        knockbackCommandMain(player);
+                        player.sendMessage("\u00a7aThe profile \u00a7e" + name + " \u00a7ahas been removed.");
+                    } else {
+                        player.sendMessage("\u00a7cThis profile doesn't exist.");
+                    }
+                    return true;
+                }
+                case "load": {
+                    KnockbackProfile profile = KnockbackConfig.getKbProfileByName(name);
+                    if (profile == null) {
+                        player.sendMessage("\u00a7cThis profile doesn't exist.");
+                    } else if (KnockbackConfig.getCurrentKb() == profile) {
+                        player.sendMessage("\u00a7cThis profile is loaded.");
+                    } else {
+                        KnockbackConfig.setCurrentKb(profile);
+                        knockbackCommandMain(player);
+                        player.sendMessage("\u00a7aThe profile \u00a7e" + profile.getName() + " \u00a7ahas been loaded.");
+                    }
+                    return true;
+                }
+                case "view": {
+                    KnockbackProfile profile = KnockbackConfig.getKbProfileByName(name);
+                    if (profile == null) {
+                        player.sendMessage("\u00a7cThis profile doesn't exist.");
+                    } else {
+                        knockbackCommandView(player, profile);
+                    }
+                    return true;
+                }
+                case "projectile": {
+                    KnockbackProfile profile = KnockbackConfig.getKbProfileByName(name);
+                    if (profile == null) {
+                        player.sendMessage("\u00a7cThis profile doesn't exist.");
+                    } else {
+                        knockbackCommandViewProjectiles(player, profile);
+                    }
+                    return true;
+                }
+            }
+        } else if (args.length == 3 && "set".equalsIgnoreCase(args[0])) {
+            KnockbackProfile profile = KnockbackConfig.getKbProfileByName(args[1]);
+            if (profile == null) {
+                player.sendMessage("\u00a7cA profile with that name could not be found.");
+                return true;
+            }
+            Player target = Bukkit.getPlayer(args[2]);
+            if (target == null) {
+                player.sendMessage("\u00a7cThat player is not online.");
+                return true;
+            }
+            target.setKnockbackProfile(profile);
+            player.sendMessage("\u00a7aApplied the profile \u00a7e" + profile.getName() + " \u00a7ato \u00a7e" + target.getName() + "\u00a7a.");
+            return true;
+        } else if (args.length == 4 && "edit".equalsIgnoreCase(args[0])) {
+            KnockbackProfile profile = KnockbackConfig.getKbProfileByName(args[1]);
+            if (profile == null) {
+                player.sendMessage("\u00a7cThis profile doesn't exist.");
+                return true;
+            }
+            edit(player, profile, args[2].toLowerCase(), args[3]);
+            return true;
+        }
+
+        knockbackCommandMain(player);
+        return true;
+    }
+
+    private void edit(Player player, KnockbackProfile profile, String key, String input) {
+        if ("stop-sprint".equals(key)) {
+            if (!"true".equalsIgnoreCase(input) && !"false".equalsIgnoreCase(input)) {
+                player.sendMessage("\u00a74" + input + " \u00a7cis not a boolean.");
+                return;
+            }
+            profile.setStopSprint(Boolean.parseBoolean(input));
+            profile.save();
+            knockbackCommandView(player, profile);
+            player.sendMessage("\u00a7aValue edited and saved.");
+            return;
+        }
+
+        double value;
+        try {
+            value = Double.parseDouble(input);
+        } catch (NumberFormatException ex) {
+            player.sendMessage("\u00a74" + input + " \u00a7cis not a number.");
+            return;
+        }
+        if (Double.isNaN(value)) {
+            player.sendMessage("\u00a74" + input + " \u00a7cis not a number.");
+            return;
+        }
+
+        switch (key) {
+            case "horizontal": profile.setHorizontal(value); break;
+            case "vertical": profile.setVertical(value); break;
+            case "vertical-max": profile.setVerticalMax(value); break;
+            case "vertical-min": profile.setVerticalMin(value); break;
+            case "extra-horizontal": profile.setExtraHorizontal(value); break;
+            case "extra-vertical": profile.setExtraVertical(value); break;
+            case "friction-horizontal": profile.setFrictionHorizontal(value); break;
+            case "friction-vertical": profile.setFrictionVertical(value); break;
+            case "wtap-extra-horizontal": profile.setWTapExtraHorizontal(value); break;
+            case "wtap-extra-vertical": profile.setWTapExtraVertical(value); break;
+            case "add-horizontal": profile.setAddHorizontal(value); break;
+            case "add-vertical": profile.setAddVertical(value); break;
+            case "rod-horizontal": profile.setRodHorizontal(value); break;
+            case "rod-vertical": profile.setRodVertical(value); break;
+            case "arrow-horizontal": profile.setArrowHorizontal(value); break;
+            case "arrow-vertical": profile.setArrowVertical(value); break;
+            case "pearl-horizontal": profile.setPearlHorizontal(value); break;
+            case "pearl-vertical": profile.setPearlVertical(value); break;
+            case "snowball-horizontal": profile.setSnowballHorizontal(value); break;
+            case "snowball-vertical": profile.setSnowballVertical(value); break;
+            case "egg-horizontal": profile.setEggHorizontal(value); break;
+            case "egg-vertical": profile.setEggVertical(value); break;
+            default:
+                player.sendMessage("\u00a7cUnknown knockback value \u00a74" + key + "\u00a7c.");
+                return;
+        }
+        profile.save();
+        if (PROJECTILE_VALUES.contains(key)) {
+            knockbackCommandViewProjectiles(player, profile);
+        } else {
+            knockbackCommandView(player, profile);
+        }
+        player.sendMessage("\u00a7aValue edited and saved.");
+    }
+
+    @Override
+    public List<String> tabComplete(CommandSender sender, String alias, String[] args) {
+        if (args.length == 1) {
+            return StringUtil.copyPartialMatches(args[0], SUBCOMMANDS, new ArrayList<String>());
+        }
+        if (args.length == 2 && SUBCOMMANDS.contains(args[0].toLowerCase()) && !"create".equalsIgnoreCase(args[0])) {
+            List<String> names = new ArrayList<>();
+            for (KnockbackProfile profile : KnockbackConfig.getKbProfiles()) {
+                names.add(profile.getName());
+            }
+            return StringUtil.copyPartialMatches(args[1], names, new ArrayList<String>());
+        }
+        if (args.length == 3 && "edit".equalsIgnoreCase(args[0])) {
+            List<String> values = new ArrayList<>(KNOCKBACK_VALUES);
+            values.addAll(PROJECTILE_VALUES);
+            return StringUtil.copyPartialMatches(args[2], values, new ArrayList<String>());
+        }
+        if (args.length == 3 && "set".equalsIgnoreCase(args[0])) {
+            return super.tabComplete(sender, alias, args);
+        }
+        return ImmutableList.of();
+    }
+
+    private void knockbackCommandMain(Player player) {
+        player.sendMessage(SEPARATOR + "\n\u00a7a\u00a7lKnockback profile list:\n");
+
+        for (KnockbackProfile profile : KnockbackConfig.getKbProfiles()) {
+            boolean current = KnockbackConfig.getCurrentKb() == profile;
+
+            TextComponent line = clickable("\u00a78\u00a7l(\u00a7e\u00a7l\u279c\u00a78\u00a7l) ",
+                    "\u00a7c[Click here to apply this profile to a player] ",
+                    "/kb set " + profile.getName() + " ", ClickEvent.Action.SUGGEST_COMMAND);
+            TextComponent load = clickable("\u00a78\u00a7l(" + (current ? "\u00a7a" : "\u00a77") + "\u2714\u00a78\u00a7l) ",
+                    current ? "\u00a7c[This profile is loaded] " : "\u00a7a[Click here to load this profile]",
+                    "/kb load " + profile.getName(), ClickEvent.Action.RUN_COMMAND);
+            TextComponent delete = clickable("\u00a78\u00a7l(\u00a7c\u00a7l\u2716\u00a78\u00a7l) ",
+                    "\u00a7c[Click here to delete this profile] ",
+                    "/kb delete " + profile.getName(), ClickEvent.Action.RUN_COMMAND);
+            TextComponent edit = clickable("\u00a77 " + profile.getName() + " \u00a78\u00a7l[\u00a76\u00a7l\u270e\u00a78\u00a7l]",
+                    "\u00a7e[Click here to edit this profile]",
+                    "/kb view " + profile.getName(), ClickEvent.Action.RUN_COMMAND);
+            player.spigot().sendMessage(new BaseComponent[] { line, load, delete, edit });
+        }
+
+        player.spigot().sendMessage(clickable("\n\u00a78\u00a7l[\u00a7a\u00a7lCreate new profile\u00a78]",
+                "\u00a7c[Click here to create a new profile]", "/kb create ", ClickEvent.Action.SUGGEST_COMMAND));
+        player.sendMessage(SEPARATOR);
+    }
+
+    private void knockbackCommandView(Player player, KnockbackProfile profile) {
+        player.sendMessage(SEPARATOR + "\n\u00a7a\u00a7lKnockback values:\n");
+        sendValues(player, profile, profile.getKnockbackValues());
+        TextComponent back = clickable("\n\u00a78\u00a7l[\u00a7c\u00a7l\u2b11\u00a78\u00a7l] ", "\u00a7e[Click to back]",
+                "/kb", ClickEvent.Action.RUN_COMMAND);
+        TextComponent projectiles = clickable(" \u00a78\u00a7l[\u00a7a\u00a7lEdit projectiles\u00a78\u00a7l]",
+                "\u00a7e[Click to edit projectiles]", "/kb projectile " + profile.getName(), ClickEvent.Action.RUN_COMMAND);
+        player.spigot().sendMessage(new BaseComponent[] { back, projectiles });
+        player.sendMessage(SEPARATOR);
+    }
