+        profile.setEggVertical(config.getDouble(path + ".projectiles.egg.vertical", 0.4D));
+        // Write back missing keys so the file always lists every value
+        profile.write(true);
+    }
+
+    /**
+     * Carries over the knockback section that paper.yml used to hold, so
+     * servers that tuned it keep their knockback.
+     */
+    private static void migrateLegacyKnockback(CraftKnockbackProfile profile) {
+        ConfigurationSection legacy = org.github.paperspigot.PaperSpigotConfig.legacyKnockback;
+        if (legacy == null) {
+            return;
+        }
+        double friction = legacy.getDouble("friction", 2.0D);
+        profile.setFrictionHorizontal(friction);
+        profile.setFrictionVertical(friction);
+        profile.setHorizontal(legacy.getDouble("horizontal", 0.4D));
+        profile.setVertical(legacy.getDouble("vertical", 0.4D));
+        profile.setVerticalMax(legacy.getDouble("vertical-limit", 0.4D));
+        profile.setExtraHorizontal(legacy.getDouble("extra-horizontal", 0.5D));
+        profile.setWTapExtraHorizontal(legacy.getDouble("extra-horizontal", 0.5D));
+        profile.setExtraVertical(legacy.getDouble("extra-vertical", 0.1D));
+        profile.setWTapExtraVertical(legacy.getDouble("extra-vertical", 0.1D));
+        Bukkit.getLogger().info("Migrated the paper.yml knockback settings into the knockback.yml 'default' profile");
+    }
+
+    /**
+     * The extra profiles WindSpigot ships, written once when knockback.yml is created.
+     */
+    private static void createWindSpigotPresets() {
