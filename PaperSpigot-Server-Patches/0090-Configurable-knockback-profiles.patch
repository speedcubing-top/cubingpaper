+
+    /**
+     * Community profiles, added whenever they are missing (so existing knockback.yml files get them too).
+     * Approximations: our model can't express every fork's formula.
+     */
+    private static void createCommunityPresets(Set<String> keys) {
+        if (!containsIgnoreCase(keys, "mmc")) {
+            // Minemen Club, approximated from the MineralSpigot replica
+            // https://gist.github.com/jaidennnnn/d29d67217e17d745f8b7afdb146ea4e9 :
+            // horizontal = 0.8835 * 0.6, vertical = 0.9055 * 0.4, extra horizontal = 0.8835 * 0.4 per level, no extra
