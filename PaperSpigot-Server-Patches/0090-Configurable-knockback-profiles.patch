+    // CubingPaper start - Configurable knockback profiles
+    private dev.cobblesword.nachospigot.knockback.KnockbackProfile knockbackProfile;
+
+    public dev.cobblesword.nachospigot.knockback.KnockbackProfile getKnockbackProfile() {
+        return knockbackProfile;
+    }
