+        // CubingPaper start - Improve keepalive ping system
+        long now = System.nanoTime();
+        int id = packetplayinkeepalive.a();
+        synchronized (this.pendingKeepAlives) {
+            long sent = -1L;
+            for (java.util.Iterator<long[]> it = this.pendingKeepAlives.iterator(); it.hasNext();) {
+                long[] pending = it.next();
+                it.remove(); // anything sent before the answered one won't be answered either
+                if (pending[0] == id) {
+                    sent = pending[1];
+                    break;
+                }
+            }
+            if (sent == -1L) {
+                return; // not ours, or already dropped from the queue
+            }
+            long latency = now - sent;
+            this.keepAliveResponses.addLast(new long[] { sent, latency });
+            this.keepAliveLatencySumNS += latency;
+            while (sent - this.keepAliveResponses.peekFirst()[0] > PING_WINDOW_NS) {
+                this.keepAliveLatencySumNS -= this.keepAliveResponses.pollFirst()[1];
+            }
+            this.player.ping = (int) (this.keepAliveLatencySumNS / this.keepAliveResponses.size() / 1000000L);
         }
