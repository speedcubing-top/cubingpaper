+    // CubingPaper start - Improve keepalive ping system (from Paper)
+    // Send a keepalive every second and keep every unanswered one, so replies are
+    // still matched when the round trip is longer than the send interval; ping is
+    // the true average of the replies to keepalives sent in the last 5 seconds.
+    // The send runs on the main thread and the reply on the netty thread.
+    private static final long KEEPALIVE_INTERVAL_TICKS = 20L;
+    private static final long PING_WINDOW_NS = java.util.concurrent.TimeUnit.SECONDS.toNanos(5L);
+    private static final int MAX_PENDING_KEEPALIVES = 60; // the netty read timeout kicks after 30s anyway
+    private final java.util.ArrayDeque<long[]> pendingKeepAlives = new java.util.ArrayDeque<long[]>(); // {id, sent ns}
+    private final java.util.ArrayDeque<long[]> keepAliveResponses = new java.util.ArrayDeque<long[]>(); // {sent ns, latency ns}
+    private long keepAliveLatencySumNS;
+    private int nextKeepAliveId;
     private long k;
+    // CubingPaper end
     // CraftBukkit start - multithreaded fields
     private volatile int chatThrottle;
     private static final AtomicIntegerFieldUpdater chatSpamField = AtomicIntegerFieldUpdater.newUpdater(PlayerConnection.class, "chatThrottle");
@@ -126,11 +137,18 @@ public class PlayerConnection implements PacketListenerPlayIn, IUpdatePlayerList
         this.h = false;
