             this.k = (long) this.e;
-            this.j = this.d();
-            this.i = (int) this.j;
-            this.sendPacket(new PacketPlayOutKeepAlive(this.i));
+            // CubingPaper start - Improve keepalive ping system
+            int id = ++this.nextKeepAliveId;
+            synchronized (this.pendingKeepAlives) {
+                if (this.pendingKeepAlives.size() >= MAX_PENDING_KEEPALIVES) {
+                    this.pendingKeepAlives.pollFirst();
+                }
+                this.pendingKeepAlives.addLast(new long[] { id, System.nanoTime() });
+            }
+            this.sendPacket(new PacketPlayOutKeepAlive(id));
+            // CubingPaper end
         }
 
         this.minecraftServer.methodProfiler.b();
@@ -1933,17 +1951,34 @@ public class PlayerConnection implements PacketListenerPlayIn, IUpdatePlayerList
     }
 
     public void a(PacketPlayInKeepAlive packetplayinkeepalive) {
