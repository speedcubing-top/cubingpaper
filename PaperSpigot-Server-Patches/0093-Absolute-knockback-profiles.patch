@@ -136,12 +137,19 @@ public class KnockbackCommand extends Command {
     }
 
     private void edit(Player player, KnockbackProfile profile, String key, String input) {
-        if ("stop-sprint".equals(key)) {
+        if ("stop-sprint".equals(key) || "absolute".equals(key) || "client-sprint".equals(key)) {
             if (!"true".equalsIgnoreCase(input) && !"false".equalsIgnoreCase(input)) {
                 player.sendMessage("\u00a74" + input + " \u00a7cis not a boolean.");
                 return;
             }
-            profile.setStopSprint(Boolean.parseBoolean(input));
+            boolean value = Boolean.parseBoolean(input);
+            if ("stop-sprint".equals(key)) {
+                profile.setStopSprint(value);
+            } else if ("absolute".equals(key)) {
+                profile.setAbsolute(value);
+            } else {
+                profile.setClientSprint(value);
+            }
             profile.save();
             knockbackCommandView(player, profile);
             player.sendMessage("\u00a7aValue edited and saved.");
diff --git a/src/main/java/top/speedcubing/cubingpaper/knockback/KnockbackConfig.java b/src/main/java/top/speedcubing/cubingpaper/knockback/KnockbackConfig.java
