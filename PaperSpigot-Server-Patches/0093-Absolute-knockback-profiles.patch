         profile.setWTapExtraVertical(config.getDouble(path + ".wtap-extra-vertical", 0.1D));
         profile.setAddHorizontal(config.getDouble(path + ".add-horizontal", 0.0D));
         profile.setAddVertical(config.getDouble(path + ".add-vertical", 0.0D));
