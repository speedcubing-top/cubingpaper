             mmc.setWTapExtraVertical(0.0D);
             mmc.write(true);
         }
+        if (!containsIgnoreCase(keys, "absolute")) {
+            // The practice plugin's former AbsoluteKnockback listener, with the values prod tuned it to through /akb:
+            // every melee hit sets the victim's velocity to 0.425 away + 0.36 up, plus 0.31 along the attacker's facing
+            // on a sprint hit (the client's sprint counts)
+            CraftKnockbackProfile absolute = new CraftKnockbackProfile("absolute");
+            absolute.setAbsolute(true);
+            absolute.setClientSprint(true);
+            absolute.setHorizontal(0.425D);
+            absolute.setVertical(0.36D);
+            absolute.setExtraHorizontal(0.0D);
+            absolute.setExtraVertical(0.0D);
+            absolute.setWTapExtraHorizontal(0.31D);
+            absolute.setWTapExtraVertical(0.0D);
+            absolute.write(true);
+        }
         if (!containsIgnoreCase(keys, "velocity")) {
             // "Velocity" from https://github.com/tdvne/Bot-Practice/blob/master/src/main/resources/knockback.yml
             CraftKnockbackProfile velocity = new CraftKnockbackProfile("velocity");
