From 2e671416dfb15f0fe765c9f3e5ba9f7014e985d0 Mon Sep 17 00:00:00 2001
From: HaeImAlan <me@haeimalan.com>
Date: Mon, 16 Nov 2026 11:47:12 +0800
Subject: [PATCH] Absolute knockback profiles

A profile with absolute: true sets the victim's velocity on a player melee hit (horizontal along the
attacker-to-victim line, vertical up) instead of adding to its motion; friction, the add values and the
vertical limits are skipped, the (wtap-)extra values still apply. client-sprint: true also counts the
client's sprint packets as sprinting, so stop-sprint no longer drops the sprint extra while W is held.
Adds the 'absolute' preset: the practice plugin's AbsoluteKnockback with the values prod tuned it to
(0.425 / 0.36, sprint extra 0.31).

diff --git a/src/main/java/net/minecraft/server/EntityHuman.java b/src/main/java/net/minecraft/server/EntityHuman.java
index c2f93d15..ecc34965 100644
--- a/src/main/java/net/minecraft/server/EntityHuman.java
+++ b/src/main/java/net/minecraft/server/EntityHuman.java
@@ -969,7 +969,11 @@ public abstract class EntityHuman extends EntityLiving {
 
                 int i = b0 + EnchantmentManager.a((EntityLiving) this);
 
-                boolean sprintHit = this.isSprinting(); // CubingPaper - Configurable knockback profiles
+                // CubingPaper start - Configurable knockback profiles; client-sprint also counts the client's sprint state,
+                // which stop-sprint (server flag only) does not clear while W is held
+                dev.cobblesword.nachospigot.knockback.KnockbackProfile kb = entity.getEffectiveKnockbackProfile();
+                boolean sprintHit = this.isSprinting() || (kb.isClientSprint() && this instanceof EntityPlayer && ((EntityPlayer) this).clientSprinting);
+                // CubingPaper end
                 if (sprintHit) {
                     ++i;
                 }
@@ -1005,7 +1009,7 @@ public abstract class EntityHuman extends EntityLiving {
                     if (flag2) {
                         if (i > 0) {
                             // CubingPaper start - Configurable knockback profiles (ported from WindSpigot)
-                            dev.cobblesword.nachospigot.knockback.KnockbackProfile kb = entity.getEffectiveKnockbackProfile();
+                            // kb: the victim's profile, read above
                             double extraHorizontal = sprintHit ? kb.getWTapExtraHorizontal() : kb.getExtraHorizontal();
                             double extraVertical = sprintHit ? kb.getWTapExtraVertical() : kb.getExtraVertical();
                             entity.g(
diff --git a/src/main/java/net/minecraft/server/EntityLiving.java b/src/main/java/net/minecraft/server/EntityLiving.java
index f5b0f576..c6de667a 100644
--- a/src/main/java/net/minecraft/server/EntityLiving.java
+++ b/src/main/java/net/minecraft/server/EntityLiving.java
@@ -913,6 +913,18 @@ public abstract class EntityLiving extends Entity {
             KnockbackProfile kb = this.getEffectiveKnockbackProfile();
             double magnitude = MathHelper.sqrt(d0 * d0 + d1 * d1);
 
+            // CubingPaper start - Absolute knockback: a player melee hit sets the velocity instead of adding to it, so the
+            // victim's own motion, friction, the add values and the vertical limits play no part. The (wtap-)extra values
+            // are still added by EntityHuman#attack afterwards. Projectiles and thorns keep the formula below.
+            if (kb.isAbsolute() && damagesource instanceof EntityDamageSource && !(damagesource instanceof EntityDamageSourceIndirect)
+                    && "player".equals(damagesource.translationIndex) && damagesource.getEntity() instanceof EntityHuman) {
+                this.motX = -d0 / magnitude * kb.getHorizontal();
+                this.motY = kb.getVertical();
+                this.motZ = -d1 / magnitude * kb.getHorizontal();
+                return;
+            }
+            // CubingPaper end
+
             double horizontal = kb.getHorizontal();
             double vertical = kb.getVertical();
             if (damagesource instanceof EntityDamageSourceIndirect) {
